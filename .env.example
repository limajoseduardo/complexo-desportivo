# Obrigatório: chave da API Gemini AI
GEMINI_API_KEY=COLOCA_AQUI_A_TUA_CHAVE_GEMINI

# Base URL da app (/ para VM, /complexo-desportivo/ para GitHub Pages)
VITE_BASE_URL=/

# Firebase Emulator (apenas para desenvolvimento local)
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
# VITE_FIRESTORE_EMULATOR_PORT=8080
# VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# SMTP para envio de Avisos Gerais por email (api/send-email.ts).
# Configurar como variáveis de ambiente no projeto Vercel — nunca aqui no repo.
# SMTP_HOST=smtp.cm-viladerei.pt
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=avisos@cm-viladerei.pt
